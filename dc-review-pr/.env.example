# Copy this file to `.env` (same folder as review.py) and fill in the values.
# `.env` is gitignored — never commit your real API key.

# Personal API key with the `task:write` scope.
# Create one at: PostHog -> Settings -> User -> Personal API keys.
# Scope it to `task:write` (and the project below).
POSTHOG_API_KEY=

# Project (team) id — the number in your PostHog URL: /project/<id>
POSTHOG_PROJECT_ID=

# Target repo as org/repo. Default is PostHog/posthog if unset.
DC_REVIEW_REPO=

# API host. Default is https://us.posthog.com if unset.
# Use https://eu.posthog.com for EU cloud, or your self-hosted URL.
POSTHOG_HOST=

# Slack incoming webhook URL. Required for --slack.
DC_REVIEW_SLACK_WEBHOOK=

# Task channel (Space) UUID. Unset = leave the task unfiled.
DC_REVIEW_CHANNEL=
